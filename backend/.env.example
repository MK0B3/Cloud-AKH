# Copy to .env and fill in. In production these come from the container
# runtime on EC2, not from a file — see config/env.js.

PORT=3000

# Region everything is deployed in
AWS_REGION=eu-west-1

# DynamoDB tables — match the Terraform `project_name` prefix
PAPERS_TABLE=aikhub-papers
SUBSCRIPTIONS_TABLE=aikhub-subscriptions

# S3 bucket holding the Polly-generated audio. The deployed name is
# account-suffixed: `terraform -chdir=infra output -raw audio_bucket_name`
S3_BUCKET=aikhub-audio-summaries-<aws-account-id>
